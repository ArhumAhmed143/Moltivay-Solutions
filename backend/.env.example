# Server Port
PORT=5000

# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=https://moltivay.com,https://www.moltivay.com,http://localhost:5173,http://127.0.0.1:5173

# Set to true when the API is behind a trusted reverse proxy/load balancer
TRUST_PROXY=false

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/moltivay

# Brevo (Sendinblue) API v3 Key
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Notification recipient (CEO / Inquiries mailbox)
ADMIN_EMAIL=your@email.com

# Verified sender email registered in Brevo
SENDER_EMAIL=noreply@moltivay.com
